# ─────────────────────────────────────────────────────────────
# MindDialogue — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# ─── LLM Provider (OpenRouter) ────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# ─── Firebase Admin SDK ──────────────────────────────────────
# Option 1: Individual environment variables
FIREBASE_PROJECT_ID=mind-dailouge
FIREBASE_CLIENT_EMAIL=your_service_account_email@mind-dailouge.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option 2: Path to service account JSON file (overrides Option 1)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# ─── Server ──────────────────────────────────────────────────
PORT=8000

# ─── Auth Mode ───────────────────────────────────────────────
# Set to 'development' to bypass Firebase Auth (uses mock user)
# Set to 'production' to enforce Firebase Auth JWT validation
NODE_ENV=development